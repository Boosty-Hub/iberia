{
  "name": "iberia-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/servidor.mjs dev",
    "build": "next build",
    "start": "node scripts/servidor.mjs start",
    "lint": "eslint",
    "tipos": "tsc --noEmit",
    "probar:fireflies": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/probar-fireflies.ts",
    "probar:derivacion": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/probar-derivacion.ts",
    "probar:importacion": "node --env-file=.env.local scripts/probar-importacion.mjs",
    "probar:acceso": "node --env-file=.env.local scripts/probar-acceso.mjs",
    "probar:paginas": "node --env-file=.env.local scripts/probar-paginas.mjs",
    "capturar": "node --env-file=.env.local scripts/capturar-ui.mjs",
    "documento": "node scripts/generar-pdf.mjs",
    "crear:usuario": "node --env-file=.env.local scripts/crear-usuario.mjs",
    "cambiar:clave": "node --env-file=.env.local scripts/cambiar-clave.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pdfjs-dist": "^6.2.108",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
